<UserControl x:Class="DoodlesClient.PlayerCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DoodlesClient"
             mc:Ignorable="d"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             Margin="0 0 0 5"
             d:DesignHeight="62"
             d:DesignWidth="305">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <UserControl.Background>
        <ImageBrush ImageSource="pack://application:,,,/Images/playercard_white.png" />
    </UserControl.Background>

    <Grid Margin="2">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58px" />
            <ColumnDefinition Width="185px" />
            <ColumnDefinition Width="58px" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="1.5*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="RankLbl"
                       Grid.Column="0"
                       Text="#1"
                       Padding="0"
                       Margin="5 0 0 0"
                       FontSize="16"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Left">
            </TextBlock>

            <Image x:Name="IsHostPic"
                   Width="24"
                   Height="24"
                   Source="pack://application:,,,/Images/host.png"
                   Visibility="{Binding IsHost, Converter={StaticResource BoolToVisibility}}"
                   Margin="3,20,31,14"
                   Grid.RowSpan="2">
            </Image>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="UsernameLbl"
                       Grid.Row="0"
                       Text="{Binding Username}"
                       Padding="0"
                       Margin="0 4 0 0"
                       FontSize="20"
                       VerticalAlignment="Center">
            </TextBlock>

            <TextBlock x:Name="ScoreLbl"
                       Grid.Row="1"
                       Text="{Binding Score}"
                       FontSize="14"
                       Padding="0">
            </TextBlock>

        </Grid>

        <Image x:Name="IsDrawingPic"
               Grid.Column="2"
               Width="58"
               Height="58"
               Source="pack://application:,,,/Images/pencil2.png">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDrawing}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>


    </Grid>
</UserControl>
