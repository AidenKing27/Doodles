<Window x:Class="DoodlesClient.WelcomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoodlesClient"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="Welcome"
        Height="400"
        Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image Margin="20"
               Source="pack://application:,,,/Images/logo.png" />

        <TextBox x:Name="UsernameTxt"
                 Grid.Row="1"
                 Style="{StaticResource MessageTextBoxStyle}"
                 Tag="Enter your name"
                 MaxLength="16"
                 Margin="5"
                 VerticalContentAlignment="Center"
                 PreviewTextInput="UsernameTxt_PreviewTextInput"
                 TextChanged="UsernameTxt_TextChanged" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="CodeTxt"
                     Grid.Column="0"
                     Style="{StaticResource MessageTextBoxStyle}"
                     Tag="Room code"
                     MaxLength="5"
                     Margin="5"
                     VerticalContentAlignment="Center"
                     PreviewTextInput="CodeTxt_PreviewTextInput"
                     TextChanged="CodeTxt_TextChanged" />

            <Button x:Name="JoinBtn"
                    Grid.Column="1"
                    Style="{StaticResource DoodleButtonStyle}"
                    Content="Join Room"
                    Margin="5"
                    IsEnabled="False"
                    Click="JoinBtn_Click">
                <Button.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Images/playercard_green.png" />
                </Button.Background>

            </Button>

        </Grid>

        <Button x:Name="CreateBtn"
                Grid.Row="3"
                Style="{StaticResource DoodleButtonStyle}"
                Content="Create Private Room"
                Margin="5"
                IsEnabled="False"
                Click="CreateBtn_Click">
            <Button.Background>
                <ImageBrush ImageSource="pack://application:,,,/Images/playercard_white.png" />
            </Button.Background>

        </Button>
    </Grid>
</Window>
