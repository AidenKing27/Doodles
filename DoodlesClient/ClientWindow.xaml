<Window x:Class="DoodlesClient.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoodlesClient"
        xmlns:gl="clr-namespace:GameLibrary;assembly=GameLibrary"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        Title="Doodles"
        Height="450"
        Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="9*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Label Content="MAIN"></Label>

                    <Button x:Name="DisconnectBtn"
                            Grid.Column="2"
                            Content="Disconnect"
                            Margin="5"
                            Click="DisconnectBtn_Click">

                    </Button>
                </Grid>
            </Grid>

            <Border Grid.Row="1"
                    BorderBrush="Black"
                    BorderThickness="2"
                    Margin="10">
                <gl:Doodler x:Name="Doodler"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ThinBtn"
                        Grid.Column="0"
                        Content="Thin"
                        Margin="5"
                        Click="ThinBtn_Click">

                </Button>

                <Button x:Name="ThickBtn"
                        Grid.Column="1"
                        Content="Thick"
                        Margin="5"
                        Click="ThickBtn_Click">

                </Button>

                <Button x:Name="UndoBtn"
                        Grid.Column="2"
                        Content="Undo"
                        Margin="5"
                        Click="UndoBtn_Click">

                </Button>
            </Grid>

        </Grid>

        <Grid  Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ListBox x:Name="MessagesLst"
                     Grid.Row="0"
                     Margin="5">
                
            </ListBox>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="MessageTxt"
                         Grid.Column="0"
                         MaxLength="30"
                         Margin="5">

                </TextBox>

                <Button x:Name="SendBtn"
                        Grid.Column="1"
                        Content="Send"
                        Margin="5"
                        Click="SendBtn_Click">

                </Button>
            </Grid>

            
        </Grid>


    </Grid>


</Window>