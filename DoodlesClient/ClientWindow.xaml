<Window x:Class="DoodlesClient.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoodlesClient"
        xmlns:gl="clr-namespace:GameLibrary.Core;assembly=GameLibrary"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="Doodles"
        Height="950"
        Width="1700">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <!--Container Grid-->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1000px" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!--Left Grid-->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="80px" />
                <RowDefinition Height="*" />
                <RowDefinition Height="80px" />
            </Grid.RowDefinitions>

            <Label Content="Doodles"
                   VerticalAlignment="Center"
                   Margin="10 0 0 0"
                   FontSize="32">
            </Label>

            <!--Player List-->
            <StackPanel x:Name="PlayerList"
                        Margin="5"
                        Grid.Row="1"
                        Orientation="Vertical" />

            <Button x:Name="DisconnectBtn"
                    Grid.Row="2"
                    Content="Disconnect"
                    Margin="5"
                    Click="DisconnectBtn_Click">

            </Button>
        </Grid>

        <!--Main Grid-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80px" />
                <RowDefinition Height="*" />
                <RowDefinition Height="80px" />
            </Grid.RowDefinitions>

            <!-- Word Hint -->
            <StackPanel x:Name="WordHint"
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding IsGameStarted, Converter={StaticResource BoolToVisibility}}">
            </StackPanel>

            <!-- Doodler + Actions -->
            <Grid x:Name="DoodlerGrid"
                  Grid.Row="1"
                  Background="LightGray"
                  Margin="5">
                <Border BorderBrush="#C3C3C3"
                        BorderThickness="1">
                    <gl:Doodler x:Name="ClientDoodler"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Style="{StaticResource PlayerTurnDoodlerEnabledStyle}">
                    </gl:Doodler>
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Height="48"
                            Margin="0,8,8,0"
                            Panel.ZIndex="10"
                            Style="{StaticResource PlayerTurnVisibleStyle}">

                    <Button x:Name="UndoBtn"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="48"
                            Margin="0,0,5,0"
                            Click="UndoBtn_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/undo.png" />
                        </Button.Background>
                    </Button>

                    <Button x:Name="ClearBtn"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="48"
                            Click="ClearBtn_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/clear.png" />
                        </Button.Background>
                    </Button>

                </StackPanel>

                <Button x:Name="StartBtn"
                        Width="100"
                        Height="100"
                        Click="StartBtn_Click"
                        Style="{StaticResource HostStartVisibleButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Images/start.png" />
                    </Button.Background>
                </Button>

                <TextBlock Text="Waiting for the game to start..."
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="32"
                           Margin="0 0 0 200"
                           Style="{StaticResource VisibleUntilStartedStyle}">
                </TextBlock>

                <StackPanel x:Name="WordPanelWrapper"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Style="{StaticResource WordPanelVisibleStyle}"
                            Margin="0 0 0 100">

                    <TextBlock Text="Choose a word"
                               FontSize="32"
                               Margin="25"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                    </TextBlock>

                    <StackPanel x:Name="SelectWordPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                    </StackPanel>

                </StackPanel>

                <TextBlock x:Name="NonPlayerInfoTextLbl"
                           Text="{Binding NonPlayerInfoText}"
                           FontSize="32"
                           Margin="0 0 0 100"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Style="{StaticResource NonPlayerInfoVisibleStyle}">
                </TextBlock>

            </Grid>

            <!--Actions Grid-->
            <Grid Grid.Row="2">
                <Grid.Style>
                    <Style TargetType="Grid"
                           BasedOn="{StaticResource PlayerTurnVisibleStyle}" />
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="155px" />
                </Grid.ColumnDefinitions>

                <!--Actions Row-->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <!--Selected Colour-->
                    <Image x:Name="SelectedColour"
                           Margin="5"
                           Width="70"
                           Height="70"
                           Source="pack://application:,,,/Images/Frames/frame_%23000000.png">
                    </Image>

                    <!--Colours-->
                    <WrapPanel x:Name="ColourPalettePanel"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Width="340"
                               Height="70"
                               MaxWidth="340">
                    </WrapPanel>

                    <!--Brush Sizes-->
                    <Button x:Name="ThinBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="3"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/1Thin.png" />
                        </Button.Background>
                    </Button>

                    <Button x:Name="FineBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="6"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/2Fine.png" />
                        </Button.Background>
                    </Button>

                    <Button x:Name="MediumBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="12"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/3Medium.png" />
                        </Button.Background>
                    </Button>

                    <Button x:Name="BoldBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="24"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/4Bold.png" />
                        </Button.Background>
                    </Button>

                    <Button x:Name="ThickBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="36"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/5Thick.png" />
                        </Button.Background>
                    </Button>

                </StackPanel>

                <!--Pen Type Buttons-->
                <StackPanel Grid.Column="1"
                            Height="70"
                            Orientation="Horizontal">

                    <Button x:Name="PencilBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Click="PencilBtn_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/pencil.png" />
                        </Button.Background>
                    </Button>

                    <Button x:Name="EraseBtn"
                            Margin="5 0 5 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Click="EraseBtn_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/eraser.png" />
                        </Button.Background>
                    </Button>

                </StackPanel>

            </Grid>
        </Grid>

        <!--Right Grid-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="80px" />
                <RowDefinition Height="*" />
                <RowDefinition Height="80px" />
            </Grid.RowDefinitions>

            <!--Chat-->
            <ListBox x:Name="MessagesLst"
                     Margin="5"
                     FontSize="16"
                     Grid.Row="1">
            </ListBox>

            <!--Text Box Grid-->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="53px" />
                </Grid.ColumnDefinitions>

                <!--Text Box-->
                <TextBox x:Name="MessageTxt"
                         Grid.Column="0"
                         Margin="5"
                         MaxLength="30">

                </TextBox>

                <!--Send-->
                <Button x:Name="SendBtn"
                        Grid.Column="1"
                        Margin="0 5 5 5"
                        Width="48"
                        Content="Send"
                        Click="SendBtn_Click">
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>