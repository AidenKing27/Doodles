<Window x:Class="DoodlesClient.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoodlesClient"
        xmlns:gl="clr-namespace:GameLibrary.Core;assembly=GameLibrary"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="Doodles"
        Height="950"
        Width="1700">

    <!--Container Grid-->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1000px" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!--Left Grid-->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="80px" />
                <RowDefinition Height="*" />
                <RowDefinition Height="80px" />
            </Grid.RowDefinitions>

            <Label Content="Doodles"
                   VerticalAlignment="Center"
                   Margin="10 0 0 0"
                   FontSize="32">
            </Label>

            <!--Player List-->
            <StackPanel x:Name="PlayerList"
                        Margin="5"
                        Grid.Row="1"
                        Orientation="Vertical" />

            <Button x:Name="DisconnectBtn"
                    Grid.Row="2"
                    Content="Disconnect"
                    Margin="5"
                    Click="DisconnectBtn_Click">

            </Button>
        </Grid>

        <!--Main Grid-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="80px" />
            </Grid.RowDefinitions>

            <!-- Doodler + Actions -->
            <Grid Grid.Row="0"
                  Margin="5">
                <Border BorderBrush="Gray"
                        BorderThickness="1">
                    <gl:Doodler x:Name="ClientDoodler"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Height="48"
                            Margin="0,8,8,0"
                            Panel.ZIndex="10">
                    <Button x:Name="UndoBtn"
                            Content="Undo"
                            Width="48"
                            Margin="0,0,5,0"
                            Click="UndoBtn_Click">
                    </Button>
                    <Button x:Name="ClearBtn"
                            Content="Clear"
                            Width="48"
                            Click="ClearBtn_Click">
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="155px" />
                </Grid.ColumnDefinitions>

                <!--Actions Row-->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <!--Selected Colour-->
                    <Image x:Name="SelectedColour"
                           Margin="5"
                           Width="70"
                           Height="70"
                           Source="pack://application:,,,/Images/Frames/frame_%23000000.png">
                    </Image>

                    <!--Colours-->
                    <WrapPanel x:Name="ColourPalettePanel"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Width="340"
                               Height="70"
                               MaxWidth="340">
                    </WrapPanel>

                    <!--Brush Sizes-->
                    <Button x:Name="ThinBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="3"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/1Thin.png" />
                        </Button.Background>
                    </Button>
                    <Button x:Name="FineBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="6"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/2Fine.png" />
                        </Button.Background>
                    </Button>
                    <Button x:Name="MediumBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="12"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/3Medium.png" />
                        </Button.Background>
                    </Button>
                    <Button x:Name="BoldBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="24"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/4Bold.png" />
                        </Button.Background>
                    </Button>
                    <Button x:Name="ThickBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="36"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/5Thick.png" />
                        </Button.Background>
                    </Button>
                </StackPanel>

                <!--Pen Type Buttons-->
                <StackPanel Grid.Column="1"
                            Height="70"
                            Orientation="Horizontal">
                    <Button x:Name="PencilBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Click="PencilBtn_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/pencil.png" />
                        </Button.Background>
                    </Button>
                    <Button x:Name="EraseBtn"
                            Margin="5 0 5 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Click="EraseBtn_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/eraser.png" />
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!--Right Grid-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="80px" />
            </Grid.RowDefinitions>

            <!--Chat-->
            <ListBox x:Name="MessagesLst"
                     Margin="5"
                     Grid.Row="0">
            </ListBox>

            <!--Text Box Grid-->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="53px" />
                </Grid.ColumnDefinitions>

                <!--Text Box-->
                <TextBox x:Name="MessageTxt"
                         Grid.Column="0"
                         Margin="5"
                         MaxLength="30">

                </TextBox>

                <!--Send-->
                <Button x:Name="SendBtn"
                        Grid.Column="1"
                        Margin="0 5 5 5"
                        Width="48"
                        Content="Send"
                        Click="SendBtn_Click">
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>