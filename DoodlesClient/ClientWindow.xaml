<Window x:Class="DoodlesClient.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoodlesClient"
        xmlns:gl="clr-namespace:GameLibrary.Core;assembly=GameLibrary"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="Doodles"
        Height="720"
        Width="1280">

    <!--Container Grid-->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!--Main Grid-->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="8*" />
                <RowDefinition Height="1.15*" />
            </Grid.RowDefinitions>

            <!--Header-->
            <Grid Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Label Content="MAIN"></Label>

                    <Button x:Name="DisconnectBtn"
                            Grid.Column="2"
                            Content="Disconnect"
                            Margin="5"
                            Click="DisconnectBtn_Click">

                    </Button>
                </Grid>
            </Grid>

            <!--Doodler-->
            <Border Grid.Row="1"
                    BorderBrush="Black"
                    BorderThickness="2"
                    Margin="10">
                <gl:Doodler x:Name="ClientDoodler"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
            </Border>

            <!--Button Grid-->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.4*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!--Selected Colour-->

                <!--Colours-->
                <WrapPanel x:Name="ColourPalettePanel"
                           Grid.Column="1"
                           MaxWidth="290"
                           Margin="2" />

                <!--Function Buttons-->
                <Button x:Name="UndoBtn"
                        Grid.Column="2"
                        Content="Undo"
                        Margin="5"
                        Click="UndoBtn_Click">
                </Button>
                
                <!--Brush Sizes-->
                <Grid Grid.Column="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                </Grid>
                
            </Grid>

        </Grid>

        <!--Chat Grid-->
        <Grid  Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--Chat Log-->
            <ListBox x:Name="MessagesLst"
                     Grid.Row="0"
                     Margin="5">

            </ListBox>

            <!--Text Box-->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageTxt"
                         Grid.Column="0"
                         MaxLength="30"
                         Margin="5">

                </TextBox>

                <Button x:Name="SendBtn"
                        Grid.Column="1"
                        Content="Send"
                        Margin="5"
                        Click="SendBtn_Click">

                </Button>
            </Grid>


        </Grid>


    </Grid>


</Window>