<Window x:Class="DoodlesClient.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoodlesClient"
        xmlns:gl="clr-namespace:GameLibrary.Core;assembly=GameLibrary"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="Doodles"
        Height="1000"
        Width="1700">
    <Window.Background>
        <ImageBrush ImageSource="pack://application:,,,/Images/paper.png" />
    </Window.Background>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <!--Container Grid-->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1000px" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!--Left Grid-->
        <Grid Grid.Column="0"
              Margin="0 0 20 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="110px" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50px" />
            </Grid.RowDefinitions>

            <Image Margin="20"
                   Source="pack://application:,,,/Images/logo.png" />

            <!--Player List-->
            <StackPanel x:Name="PlayerList"
                        Margin="15 5 5 5"
                        Grid.Row="1"
                        Orientation="Vertical">
            </StackPanel>

            <Button x:Name="DisconnectBtn"
                    Grid.Row="2"
                    Content="Disconnect"
                    Style="{StaticResource DoodleButtonStyle}"
                    FontSize="16"
                    Margin="15 5 5 5"
                    Click="DisconnectBtn_Click">
                <Button.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Images/disconnect.png" />
                </Button.Background>
            </Button>
        </Grid>

        <!--Main Grid-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="110px" />
                <RowDefinition Height="*" />
                <RowDefinition Height="80px" />
            </Grid.RowDefinitions>

            <!-- Word Hint -->
            <StackPanel x:Name="WordHint"
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding IsGameStarted, Converter={StaticResource BoolToVisibility}}">
            </StackPanel>

            <!-- Doodler + Actions -->
            <Grid x:Name="DoodlerGrid"
                  Grid.Row="1"
                  Margin="5">
                <Grid.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Images/doodler_border_grey.png" />
                </Grid.Background>

                <gl:Doodler x:Name="ClientDoodler"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Margin="6"
                            Style="{StaticResource PlayerTurnDoodlerEnabledStyle}">
                </gl:Doodler>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Height="48"
                            Margin="0 12 12 0"
                            Panel.ZIndex="10"
                            Style="{StaticResource PlayerTurnVisibleStyle}">

                    <Button x:Name="UndoBtn"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="48"
                            Margin="0 0 5 0"
                            Click="UndoBtn_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/undo.png" />
                        </Button.Background>
                    </Button>

                    <Button x:Name="ClearBtn"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="48"
                            Click="ClearBtn_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/clear.png" />
                        </Button.Background>
                    </Button>

                </StackPanel>

                <Button x:Name="StartBtn"
                        Width="100"
                        Height="100"
                        Click="StartBtn_Click"
                        Style="{StaticResource HostStartVisibleButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Images/start.png" />
                    </Button.Background>
                </Button>

                <TextBlock Text="Waiting for the game to start..."
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="32"
                           Margin="0 0 0 200"
                           Style="{StaticResource VisibleUntilStartedStyle}">
                </TextBlock>

                <StackPanel x:Name="WordPanelWrapper"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical"
                            Style="{StaticResource WordPanelVisibleStyle}"
                            Margin="0 0 0 100">

                    <TextBlock Text="Choose a word"
                               FontSize="32"
                               Margin="25"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                    </TextBlock>

                    <StackPanel x:Name="SelectWordPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                    </StackPanel>

                </StackPanel>

                <TextBlock x:Name="NonPlayerInfoTextLbl"
                           Text="{Binding NonPlayerInfoText}"
                           FontSize="32"
                           Margin="0 0 0 100"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Style="{StaticResource NonPlayerInfoVisibleStyle}">
                </TextBlock>

                <Grid x:Name="RoundSummaryOverlay"
                      Visibility="{Binding IsRoundSummaryVisible, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="620"
                            MinHeight="520"
                            Padding="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/card.png" />
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="{Binding RoundEndWordText}"
                                       FontSize="42"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4" />

                            <TextBlock Text="{Binding RoundEndSubText}"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,24" />

                            <ItemsControl ItemsSource="{Binding RoundSummaryRows}"
                                          Margin="50 0 50 0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0 4 0 4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="26" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Score}"
                                                       FontSize="26" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="EndGameOverlay"
                      Visibility="{Binding IsEndGameSummaryVisible, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="620"
                            MinHeight="520"
                            Padding="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/card.png" />
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Game Over"
                                       FontSize="42"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4" />

                            <TextBlock Grid.Row="1"
                                       Text="Leaderboard"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,24" />

                            <ItemsControl Grid.Row="2"
                                          ItemsSource="{Binding EndGameRows}"
                                          Margin="50 0 50 0"
                                          VerticalAlignment="Top">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0 4 0 4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Username}"
                                                       FontSize="26" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Score}"
                                                       FontSize="26" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="RestartBtn"
                                    Grid.Row="3"
                                    Margin="5"
                                    Content="Restart Game"
                                    Style="{StaticResource DoodleButtonStyle}"
                                    Width="170"
                                    Height="40"
                                    FontSize="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Visibility="{Binding IsHost, Converter={StaticResource BoolToVisibility}}"
                                    Click="RestartBtn_Click">
                                <Button.Background>
                                    <ImageBrush ImageSource="pack://application:,,,/Images/frame_long.png" />
                                </Button.Background>
                            </Button>

                        </Grid>
                    </Border>
                </Grid>

            </Grid>

            <!--Actions Grid-->
            <Grid Grid.Row="2">
                <Grid.Style>
                    <Style TargetType="Grid"
                           BasedOn="{StaticResource PlayerTurnVisibleStyle}" />
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="155px" />
                </Grid.ColumnDefinitions>

                <!--Actions Row-->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <!--Selected Colour-->
                    <Image x:Name="SelectedColour"
                           Margin="5"
                           Width="70"
                           Height="70"
                           Source="pack://application:,,,/Images/Frames/frame_%23000000.png">
                    </Image>

                    <!--Colours-->
                    <WrapPanel x:Name="ColourPalettePanel"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Width="340"
                               Height="70"
                               MaxWidth="340">
                    </WrapPanel>

                    <!--Brush Sizes-->
                    <Button x:Name="ThinBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="3"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/1Thin.png" />
                        </Button.Background>
                    </Button>

                    <Button x:Name="FineBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="6"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/2Fine.png" />
                        </Button.Background>
                    </Button>

                    <Button x:Name="MediumBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="12"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/3Medium.png" />
                        </Button.Background>
                    </Button>

                    <Button x:Name="BoldBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="24"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/4Bold.png" />
                        </Button.Background>
                    </Button>

                    <Button x:Name="ThickBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Height="70"
                            Tag="36"
                            Click="SetThickness_Event">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/5Thick.png" />
                        </Button.Background>
                    </Button>

                </StackPanel>

                <!--Pen Type Buttons-->
                <StackPanel Grid.Column="1"
                            Height="70"
                            Orientation="Horizontal">

                    <Button x:Name="PencilBtn"
                            Margin="5 0 0 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Click="PencilBtn_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/pencil.png" />
                        </Button.Background>
                    </Button>

                    <Button x:Name="EraseBtn"
                            Margin="5 0 5 0"
                            Style="{StaticResource DoodleButtonStyle}"
                            Width="70"
                            Click="EraseBtn_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Images/eraser.png" />
                        </Button.Background>
                    </Button>

                </StackPanel>

            </Grid>
        </Grid>

        <!--Right Grid-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="110px" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50px" />
            </Grid.RowDefinitions>

            <!--Room Code-->
            <TextBlock Grid.Row="0"
                       Text="{Binding RoomCodeText}"
                       FontSize="42"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
            </TextBlock>

            <!--Chat-->
            <ListBox x:Name="MessagesLst"
                     Margin="5"
                     FontSize="16"
                     BorderThickness="0"
                     Padding="10"
                     BorderBrush="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Grid.Row="1">
                <ListBox.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Images/chat.png" />
                </ListBox.Background>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--Text Box Grid-->
            <Grid x:Name="TextBoxGrid"
                  Grid.Row="2"
                  Style="{StaticResource TextBoxGridEnabledStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58px" />
                </Grid.ColumnDefinitions>

                <!--Text Box-->
                <TextBox x:Name="MessageTxt"
                         Grid.Column="0"
                         Style="{StaticResource MessageTextBoxStyle}"
                         Margin="5"
                         VerticalContentAlignment="Center"
                         MaxLength="20">
                    <TextBox.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Images/textbox.png" />
                    </TextBox.Background>
                </TextBox>

                <!--Send-->
                <Button x:Name="SendBtn"
                        Grid.Column="1"
                        Margin="0 5 5 5"
                        Style="{StaticResource DoodleButtonStyle}"
                        Width="53"
                        IsDefault="True"
                        Content="Send"
                        Click="SendBtn_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Images/send_button.png" />
                    </Button.Background>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>