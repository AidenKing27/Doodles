<Window x:Class="DoodlesClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoodlesClient"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="Red"
                BorderThickness="2"
                CornerRadius="5"
                Margin="25">
            <local:DrawingHost x:Name="drawingHost"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Content="Thin"
                    Click="Button_Click">

            </Button>

            <Button Grid.Row="1"
                    Content="Thick"
                    Click="Button_Click">

            </Button>

            <Button x:Name="UndoBtn"
                    Grid.Row="2"
                    Content="Undo"
                    Click="UndoBtn_Click">

            </Button>
        </Grid>
    </Grid>


</Window>