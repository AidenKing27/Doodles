<Window x:Class="DoodlesClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoodlesClient"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="MainWindow"
        Height="450"
        Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="9*" />
            </Grid.RowDefinitions>

            <Label Content="MAIN"></Label>
            
            <Border Grid.Row="1"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="5"
                    Margin="25">
                <local:Doodler x:Name="drawingHost"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
            </Border>
        </Grid>
        

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Name="ThinBtn"
                    Grid.Row="0"
                    Content="Thin"
                    Click="ThinBtn_Click">

            </Button>

            <Button x:Name="ThickBtn"
                    Grid.Row="1"
                    Content="Thick"
                    Click="ThickBtn_Click">

            </Button>

            <Button x:Name="UndoBtn"
                    Grid.Row="2"
                    Content="Undo"
                    Click="UndoBtn_Click">

            </Button>
        </Grid>
    </Grid>


</Window>